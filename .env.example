# Public site URL — used for canonicals, sitemap, OpenGraph
# Non-www is canonical; www and http redirect to it (see src/middleware.ts).
NEXT_PUBLIC_SITE_URL=https://eco-ticksolutions.ca

# Analytics (ARCHITECTURE.md §0). Leave blank to disable — never commit real IDs.
NEXT_PUBLIC_GA4_ID=

# Address autocomplete on the quote form. SERVER-SIDE ONLY - deliberately not
# NEXT_PUBLIC_, so the key is never shipped to the browser. Enable "Places API
# (New)" on it and restrict by IP to the Coolify host. Leave blank and the
# address field degrades to a plain text input; the form still works.
GOOGLE_PLACES_API_KEY=

# Quote form spam protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Quote notifications -----------------------------------------------------
# Where leads are emailed, and the sender address.
# Comma-separated. Every address here receives each quote request.
QUOTE_NOTIFY_EMAIL=info@eco-ticksolutions.ca,shawn@eco-ticksolutions.ca,admin@eco-ticksolutions.ca
QUOTE_FROM_EMAIL=info@eco-ticksolutions.ca

# GOOGLE WORKSPACE ROUTE (recommended, since Eco-Tick email is on Google).
# Use an App Password, NOT the account password — generate one at
# myaccount.google.com > Security > App passwords. Requires 2-step verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@eco-ticksolutions.ca
SMTP_PASS=

# ALTERNATIVE: Resend. Only used if the SMTP_* values above are blank.
RESEND_API_KEY=

# With neither configured the lead is validated, given a reference and logged,
# but NOT emailed. Set one before driving traffic.
