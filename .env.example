# Public site URL — used for canonicals, sitemap, OpenGraph
NEXT_PUBLIC_SITE_URL=https://www.eco-ticksolutions.ca

# Analytics (ARCHITECTURE.md §0). Leave blank to disable — never commit real IDs.
NEXT_PUBLIC_GA4_ID=

# Address autocomplete on the quote form. SERVER-SIDE ONLY - deliberately not
# NEXT_PUBLIC_, so the key is never shipped to the browser. Enable "Places API
# (New)" on it and restrict by IP to the Coolify host. Leave blank and the
# address field degrades to a plain text input; the form still works.
GOOGLE_PLACES_API_KEY=

# Quote form spam protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where quote submissions are emailed. Defaults to info@eco-ticksolutions.ca.
QUOTE_NOTIFY_EMAIL=info@eco-ticksolutions.ca

# Sender address for those notifications. Must be on a domain verified in Resend.
QUOTE_FROM_EMAIL=quotes@eco-ticksolutions.ca

# Resend API key. Without it the lead is logged but NOT emailed, so set this
# before driving any traffic or enquiries will be lost silently.
RESEND_API_KEY=
